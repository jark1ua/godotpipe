; ============================================================================
; Objects.tscn — drop-in scattered world objects over the streamed terrain.
; A Node3D running terrain/ObjectScatterer.gd, pre-populated with a starter set of
; ScatterKind resources (terrain/ScatterKind.gd), each pointing at a placeholder LOD
; scene under scenes/scatter/ (trees reuse scenes/lod_tree.tscn). Instance it next to
; your TerrainStreamer and set Player Path. Replace each kind's `scene` with your real
; model (keep the visibility_range LOD wiring) and retune density/scale in the inspector.
;
; Biome routing (control-map groups): small rocks -> gravel/pebble, boulders -> rock,
; snowy boulders -> snow, trees -> grass+forest, shrubs -> grass, logs+mushrooms ->
; forest, reeds -> the waterline (placement water_edge), driftwood -> sand.
; ============================================================================
[gd_scene load_steps=23 format=3 uid="uid://dobjects0scene1"]

[ext_resource type="Script" path="res://terrain/ObjectScatterer.gd" id="1_scat"]
[ext_resource type="Script" path="res://terrain/ScatterKind.gd" id="2_kind"]
[ext_resource type="PackedScene" path="res://scenes/scatter/rock_small.tscn" id="3_rock"]
[ext_resource type="PackedScene" path="res://scenes/scatter/boulder_med.tscn" id="4_bmed"]
[ext_resource type="PackedScene" path="res://scenes/scatter/boulder_large.tscn" id="5_blrg"]
[ext_resource type="PackedScene" path="res://scenes/scatter/boulder_snowy.tscn" id="6_bsnw"]
[ext_resource type="PackedScene" path="res://scenes/lod_tree.tscn" id="7_tree"]
[ext_resource type="PackedScene" path="res://scenes/scatter/shrub.tscn" id="8_shrub"]
[ext_resource type="PackedScene" path="res://scenes/scatter/log.tscn" id="9_log"]
[ext_resource type="PackedScene" path="res://scenes/scatter/reeds.tscn" id="10_reeds"]
[ext_resource type="PackedScene" path="res://scenes/scatter/driftwood.tscn" id="11_drift"]
[ext_resource type="PackedScene" path="res://scenes/scatter/mushrooms.tscn" id="12_mush"]

