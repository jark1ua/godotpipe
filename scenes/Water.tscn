; ============================================================================
; Water.tscn — sea + inland lakes for the streamed terrain.
; A Node3D running terrain/WaterPlanner.gd, pre-wired with a ShaderMaterial on
; shaders/water_body.gdshader. Instance it next to your TerrainStreamer and set
; Player Path. Requires terrain/water_bodies.json (+ terrain/water_masks/*), which
; you generate with: python3 tools/build_water_bodies.py
; ============================================================================
[gd_scene load_steps=4 format=3 uid="uid://dw4t3r0scene01"]

[ext_resource type="Script" path="res://terrain/WaterPlanner.gd" id="1_water"]
[ext_resource type="Shader" path="res://shaders/water_body.gdshader" id="2_wbody"]

[sub_resource type="ShaderMaterial" id="Mat_water"]
render_priority = 0
shader = ExtResource("2_wbody")
shader_parameter/shallow_color = Color(0.16, 0.45, 0.55, 1)
shader_parameter/deep_color = Color(0.02, 0.12, 0.22, 1)
shader_parameter/fresnel_color = Color(0.55, 0.75, 0.85, 1)
shader_parameter/alpha = 0.82
shader_parameter/wave_speed = 0.6
shader_parameter/wave_height = 0.12
shader_parameter/wave_freq = 0.25
shader_parameter/use_mask = false
shader_parameter/mask_min = Vector2(0, 0)
shader_parameter/mask_max = Vector2(1, 1)

[node name="Water" type="Node3D"]
script = ExtResource("1_water")
water_material = SubResource("Mat_water")
