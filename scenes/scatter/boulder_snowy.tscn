; ============================================================================
; boulder_snowy.tscn — placeholder SNOW-capped boulder for SNOW terrain.
; Same boulder silhouette as boulder_med, but a snow-white cap sphere sits on a
; grey rock base so it reads as a snowed-over rock. 3 LODs incl. billboard far.
; ============================================================================
[gd_scene load_steps=7 format=3 uid="uid://oscat0bouldsnw"]

[sub_resource type="SphereMesh" id="m_rock"]
radius = 0.95
height = 1.3
radial_segments = 9
rings = 5

[sub_resource type="StandardMaterial3D" id="mat_rock"]
albedo_color = Color(0.5, 0.5, 0.52, 1)
roughness = 1.0

[sub_resource type="SphereMesh" id="m_snow"]
radius = 0.9
height = 1.0
radial_segments = 9
rings = 5
is_hemisphere = true

[sub_resource type="StandardMaterial3D" id="mat_snow"]
albedo_color = Color(0.92, 0.94, 0.97, 1)
roughness = 0.85

[sub_resource type="QuadMesh" id="m_far"]
size = Vector2(2.0, 1.6)

[sub_resource type="StandardMaterial3D" id="mat_far"]
albedo_color = Color(0.85, 0.88, 0.92, 1)
shading_mode = 0
billboard_mode = 1
billboard_keep_scale = true

[node name="BoulderSnowy" type="Node3D"]

[node name="Near_Rock" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.6, 0)
visibility_range_end = 70.0
visibility_range_end_margin = 14.0
visibility_range_fade_mode = 1
mesh = SubResource("m_rock")
material_override = SubResource("mat_rock")

[node name="Near_SnowCap" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.62, 0)
visibility_range_end = 70.0
visibility_range_end_margin = 14.0
visibility_range_fade_mode = 1
mesh = SubResource("m_snow")
material_override = SubResource("mat_snow")

[node name="Far_Billboard" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.8, 0)
visibility_range_begin = 64.0
visibility_range_begin_margin = 14.0
visibility_range_fade_mode = 1
mesh = SubResource("m_far")
material_override = SubResource("mat_far")
