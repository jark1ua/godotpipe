; ============================================================================
; terrain_test.tscn — standalone scene to test the streamed terrain.
; A gravity-driven CharacterBody3D player (TerrainPlayer.gd) walks/falls on the
; chunked terrain; moving it drives TerrainStreamer.gd to load/free chunks by
; distance. Sky + sun + light fog so the far (unloaded) edge fades out.
;
; Spawn sits just above the centre chunk (15,15), which is a ~1.4 km mountain
; peak at the world origin — so the player lands on the surface, not under it.
; The streamer loads the chunk under the player synchronously on spawn, so the
; ground/collision is there on the first frame.
;
; Run directly from the editor (F6). Controls: WASD + mouse move/look, Shift
; sprint, Space jump, V to toggle no-clip fly (fast traversal), Esc to release
; the mouse (Esc again -> main menu). To tinker with the terrain inside the
; editor (no play), select the Terrain node and click "Load Editor Preview".
; ============================================================================
[gd_scene load_steps=10 format=3 uid="uid://bterraintest001"]

[ext_resource type="Script" path="res://scripts/TerrainPlayer.gd" id="1_player"]
[ext_resource type="PackedScene" path="res://scenes/Terrain.tscn" id="2_terrain"]
[ext_resource type="PackedScene" path="res://scenes/Grass.tscn" id="3_grass"]
[ext_resource type="PackedScene" path="res://scenes/Water.tscn" id="4_water"]
[ext_resource type="PackedScene" path="res://scenes/Objects.tscn" id="5_objects"]

[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]
sky_horizon_color = Color(0.64, 0.66, 0.7, 1)
ground_horizon_color = Color(0.64, 0.66, 0.7, 1)

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
ambient_light_source = 3
tonemap_mode = 2
fog_enabled = false
fog_light_color = Color(0.64, 0.66, 0.7, 1)
fog_density = 0.0009

[sub_resource type="CapsuleShape3D" id="Capsule"]
radius = 0.4
height = 1.8

[node name="TerrainTest" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

[node name="Sun" type="DirectionalLight3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 0.5, -0.866025, 0, 0.866025, 0.5, 0, 0, 0)
light_energy = 1.1
shadow_enabled = true

[node name="Player" type="CharacterBody3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1401, 0)
script = ExtResource("1_player")

[node name="Collision" type="CollisionShape3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("Capsule")

[node name="Camera3D" type="Camera3D" parent="Player"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.6, 0)
current = true
far = 16000.0

[node name="Terrain" parent="." instance=ExtResource("2_terrain")]
player_path = NodePath("../Player")

[node name="Grass" parent="." instance=ExtResource("3_grass")]
player_path = NodePath("../Player")

[node name="Water" parent="." instance=ExtResource("4_water")]
player_path = NodePath("../Player")

[node name="Objects" parent="." instance=ExtResource("5_objects")]
player_path = NodePath("../Player")
