<Project Sdk="Godot.NET.Sdk/4.6.3">
  <!-- ========================================================================
       GodotPipe.csproj — the C# side of this Godot project.

       `Godot.NET.Sdk` is an MSBuild SDK restored from NuGet; it knows how to
       compile game scripts into an assembly the engine loads at runtime. There
       is no Main() — the engine is the host; these classes attach to nodes.
       The assembly name (GodotPipe) is referenced from project.godot's
       [dotnet] section.
       ===================================================================== -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- SQLite for item definitions + persistent records. Microsoft.Data.Sqlite
       pulls in SQLitePCLRaw.bundle_e_sqlite3, which ships the native sqlite
       binary for Windows/Linux/macOS, so no system SQLite install is needed. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>
</Project>
