# --- Godot 4 ---
# Engine cache & import artifacts. Regenerated automatically on first
# `--import` / editor open, so they don't belong in version control.
.godot/

# Exported game builds / packed archives.
/export/
*.pck
*.zip
export_presets.cfg

# --- Tooling installed OUTSIDE the repo (see scripts/) ---
# The engine binary and the godot-mcp server live in /home/user/tools and are
# (re)created by scripts/setup_*.sh — never commit those big artifacts.

# --- .NET / C# build artifacts (restored + compiled by `dotnet build`) ---
bin/
obj/
*.user

# --- OS / editor junk ---
.DS_Store
*~
__pycache__/
*.pyc

# Regenerable debug previews from tools/bake_biome_control_map.py
/terrain/control_map_16k_layer_preview.png
/terrain/control_map_16k_biome_preview.png

terrain/chunks/*.glb
terrain/chunks/*.glb.import
