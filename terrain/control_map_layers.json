{
  "version": "1.0",
  "control_map": "terrain_control_map_16k.exr",
  "control_map_resolution": 2048,
  "control_map_bit_depth": 16,
  "world_size_m": 16000,
  "control_map_source": "Baked from the painted Azgaar biome map by tools/bake_biome_control_map.py (biome colour -> texture layer). Base layer only so far; slope/altitude overlays (rock on cliffs, snow up high) are a follow-up that needs terrain_heightmap_16k.png.",
  "uv_mapping": "uv=((world_x+8000)/16000,(world_y+8000)/16000); image TOP row = south (uv.y=0), col0 = west (uv.x=0). Matches terrain chunk world UVs.",
  "encoding": {
    "format": "16-bit single-channel grayscale PNG (R channel)",
    "decode_int": "V = round(texture_R * 65535.0)",
    "base_layer_index": "V & 31",
    "overlay_layer_index": "(V >> 5) & 31",
    "blend_raw": "(V >> 10) & 31",
    "blend_weight": "(blend_raw/31.0)*0.5   // 0..0.5 = fraction of overlay at this texel; 0.5 = 50/50 boundary",
    "bits_used": 15,
    "packing": "packed = base | (overlay<<5) | (blend_raw<<10); blend_raw=round(clamp(2*overlay/(base+overlay),0,1)*31)"
  },
  "layer_count": 32,
  "dropped_categories": [
    "fungal_growth (cave/underground biome) — dropped so 32 surface layers pack exactly into 5+5+5 bits"
  ],
  "texture_status": "31 of 32 layers have dedicated PBR sets in output/ (every index 0-31 EXCEPT idx2 rock_basalt_volcanic, which is deliberately skipped - no good dark-volcanic terrain scan on PolyHaven - and still points to the rock placeholder). Approximations where no exact scan exists (real sources, graded to fit): idx9 heather, idx18 fern, idx22 brokenslate, idx30 bone_field. All other sets are dedicated photoscanned PBR. Each layer's 'source' field documents the PolyHaven asset(s) used.",
  "maps_per_layer": [
    "albedo (sRGB)",
    "normal (OpenGL Y+)",
    "height",
    "ao",
    "rough"
  ],
  "texture2d_array_plan": "Build Texture2DArrays (albedo sRGB / normal linear / ORM=AO,Rough,0) + optional height array; all layers 2K, same format, ordered by index 0..31. Shader: unpack control map -> sample base & overlay via texture(arr,vec3(world_uv*1/tile_m,layer)) -> height-blend by blend_weight -> triplanar where layer.triplanar.",
