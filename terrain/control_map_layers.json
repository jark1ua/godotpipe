  "uv_mapping": "uv=((world_x+3000)/6000,(world_y+3000)/6000); image TOP row = south (uv.y=0), col0 = west (uv.x=0). Matches existing terrain chunk world UVs & terrain_splatmap.png.",
  "encoding": {
    "format": "16-bit single-channel grayscale PNG (R channel)",
    "decode_int": "V = round(texture_R * 65535.0)",
    "base_layer_index": "V & 31",
    "overlay_layer_index": "(V >> 5) & 31",
    "blend_raw": "(V >> 10) & 31",
    "blend_weight": "(blend_raw/31.0)*0.5   // 0..0.5 = fraction of overlay at this texel; 0.5 = 50/50 boundary",
    "bits_used": 15,
    "packing": "packed = base | (overlay<<5) | (blend_raw<<10); blend_raw=round(clamp(2*overlay/(base+overlay),0,1)*31)"
  },
  "layer_count": 32,
  "dropped_categories": [
    "fungal_growth (cave/underground biome) \u2014 dropped so 32 surface layers pack exactly into 5+5+5 bits"
  ],
  "texture_status": "Only 4 PBR sets currently exist in output/ (grass, rock, snow, sand). The other 28 categories point to the nearest existing set (is_placeholder=true) until dedicated sets are baked.",
  "maps_per_layer": [
    "albedo (sRGB)",
    "normal (OpenGL Y+)",
    "height",
    "ao",
    "rough"
  ],
